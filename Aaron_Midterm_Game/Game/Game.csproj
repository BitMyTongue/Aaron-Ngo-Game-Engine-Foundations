<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Door.obj" />
    <None Remove="Assets\House.obj" />
    <None Remove="Assets\Key.obj" />
    <None Remove="Assets\Lantern.obj" />
    <None Remove="Assets\Table.obj" />
    <None Remove="Assets\Textures\dirt.jpg" />
    <None Remove="Assets\Textures\door.jpg" />
    <None Remove="Assets\Textures\grass.jpeg" />
    <None Remove="Assets\Textures\house.jpg" />
    <None Remove="Assets\Textures\key.jpg" />
    <None Remove="Assets\Textures\lantern.jpg" />
    <None Remove="Assets\Textures\table.jpg" />
    <None Remove="Shaders\fragment.glsl" />
    <None Remove="Shaders\vertex.glsl" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Door.obj">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\House.obj">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Key.obj">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Lantern.obj">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Table.obj">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\dirt.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\door.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\grass.jpeg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\house.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\key.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\lantern.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Textures\table.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Shaders\fragment.glsl">
